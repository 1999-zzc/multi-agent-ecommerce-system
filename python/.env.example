# LLM Configuration
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.minimax.chat/v1
ECOM_LLM_MODEL=MiniMax-M1

# Qwen Embedding
ECOM_QWEN_API_KEY=your_qwen_api_key_here
ECOM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ECOM_QWEN_EMBEDDING_MODEL=text-embedding-v4
ECOM_EMBEDDING_DIM=1024

# Redis
ECOM_REDIS_URL=redis://localhost:6379/0

# Database
ECOM_DATABASE_URL=mysql+pymysql://root:change_me@localhost:3306/ecommerce

# Milvus
ECOM_MILVUS_URI=http://localhost:19530
ECOM_MILVUS_COLLECTION=product_embeddings

# A/B Testing
ECOM_AB_TEST_ENABLED=true
